# ReactionWheel
# 2026-05-14 02:18:25Z

# IO_2@[IOP=(3)][IoId=(2)] is reserved: SWDDebugEnabled
dont_use_io iocell 3 2
# IO_3@[IOP=(3)][IoId=(3)] is reserved: SWDDebugEnabled
dont_use_io iocell 3 3
set_location "ClockGenBlock" m0s8clockgenblockcell -1 -1 0
set_io "IN_1_Out(0)" iocell 0 3
set_io "IN_2_Out(0)" iocell 2 7
set_io "IN_3_Out(0)" iocell 6 0
set_io "EN_PIN(0)" iocell 0 2
set_io "\I2C:sda(0)\" iocell 2 1
set_io "\I2C:scl(0)\" iocell 2 0
set_io "\UART:tx(0)\" iocell 7 1
